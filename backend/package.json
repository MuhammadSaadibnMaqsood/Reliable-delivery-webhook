{
  "name": "webhook-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reliable Webhook Delivery & Automation Platform — backend (Express + Prisma)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:tick": "node dist/run-worker-tick.js",
    "worker:tick:dev": "tsx src/run-worker-tick.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:new": "prisma migrate dev --create-only",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "argon2": "^0.45.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "undici": "^8.12.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.16.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
