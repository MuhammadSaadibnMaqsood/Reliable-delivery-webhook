# ---------------------------------------------------------------------------
# Database connections (NFR-24: all configuration via environment variables)
#
# DATABASE_URL  — POOLED connection used by the application at runtime.
#                 On Neon: the "-pooler" host. On Supabase: the pooler port.
#                 Keep pgbouncer=true and a small connection_limit for
#                 serverless runtimes (transaction-mode pooling).
#
# DIRECT_URL    — DIRECT (non-pooled) connection used ONLY by Prisma Migrate.
#                 Transaction-mode poolers break migrations and advisory
#                 locks, so migrations must bypass the pooler.
#
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require&pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Server
#
# NODE_ENV      — development | test | production
# PORT          — HTTP port the API listens on
# CORS_ORIGINS  — comma-separated list of allowed browser origins
#                 (e.g. the dashboard), or * to allow any origin
# LOG_LEVEL     — fatal | error | warn | info | debug | trace
# SHUTDOWN_TIMEOUT_MS — grace period before a forced exit on shutdown
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
