# ---------------------------------------------------------------------------
# Database connections (NFR-24: all configuration via environment variables)
#
# DATABASE_URL  — POOLED connection used by the application at runtime.
#                 On Neon: the "-pooler" host. On Supabase: the pooler port.
#                 Keep pgbouncer=true and a small connection_limit for
#                 serverless runtimes (transaction-mode pooling).
#
# DIRECT_URL    — DIRECT (non-pooled) connection used ONLY by Prisma Migrate.
#                 Transaction-mode poolers break migrations and advisory
#                 locks, so migrations must bypass the pooler.
#
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require&pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---------------------------------------------------------------------------
# Server
#
# NODE_ENV      — development | test | production
# PORT          — HTTP port the API listens on
# CORS_ORIGINS  — comma-separated list of allowed browser origins
#                 (e.g. the dashboard), or * to allow any origin
# LOG_LEVEL     — fatal | error | warn | info | debug | trace
# SHUTDOWN_TIMEOUT_MS — grace period before a forced exit on shutdown
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication
#
# JWT_SECRET      — HMAC-SHA256 signing secret for access tokens. REQUIRED,
#                   at least 32 chars of randomness. Generate one with:
#                   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_EXPIRES_IN  — access-token lifetime: <number><ms|s|m|h|d>, e.g. 15m, 12h, 1d
# AUTH_RATE_LIMIT_WINDOW_MS / AUTH_RATE_LIMIT_MAX
#                 — login/registration throttle (in-memory, per process)
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
JWT_EXPIRES_IN=1d
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Secret encryption
#
# SECRET_ENCRYPTION_KEY — AES-256-GCM key (64 hex chars = 32 bytes) used to
# encrypt endpoint signing secrets at rest. REQUIRED; the app refuses to boot
# without a valid key rather than ever storing plaintext. Must be a dedicated
# key — do not reuse JWT_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key requires re-encrypting stored secrets (future migration).
# ---------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# ---------------------------------------------------------------------------
# Delivery policy (provisional defaults pending the retry-policy decision)
#
# DELIVERY_MAX_ATTEMPTS_DEFAULT — attempt budget snapshotted onto each
# delivery at fan-out when the endpoint has no max_attempts override (1–20).
# WORKER_BATCH_SIZE    — max deliveries claimed per worker tick (1–100).
# WORKER_LEASE_MS      — processing lease per claim; keep well above the
#                        endpoint timeout cap so expiry means a dead worker.
# DELIVERY_TIMEOUT_MS_DEFAULT — per-attempt HTTP timeout when the endpoint
#                        has no timeout_ms override (1000–30000).
# DESTINATION_ALLOW_PRIVATE — DEV ONLY: allow the delivery path to dispatch
#                        to private/HTTP destinations (local receivers).
#                        Production refuses to boot when this is true.
# ---------------------------------------------------------------------------
# DELIVERY_RETRY_INITIAL_DELAY_MS / DELIVERY_RETRY_MAX_DELAY_MS — bounded
#                        exponential backoff: delay = min(max, initial·2^(n-1)),
#                        ±20% jitter, never above the max.
# ---------------------------------------------------------------------------
DELIVERY_MAX_ATTEMPTS_DEFAULT=5
WORKER_BATCH_SIZE=10
WORKER_LEASE_MS=60000
DELIVERY_TIMEOUT_MS_DEFAULT=10000
DESTINATION_ALLOW_PRIVATE=false
DELIVERY_RETRY_INITIAL_DELAY_MS=30000
DELIVERY_RETRY_MAX_DELAY_MS=3600000

# ---------------------------------------------------------------------------
# Worker trigger
#
# WORKER_TRIGGER_SECRET — shared secret the external scheduler sends in the
# X-Worker-Secret header to POST /internal/worker/tick. REQUIRED, >= 32
# random chars; compared timing-safely and never logged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
WORKER_TRIGGER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
